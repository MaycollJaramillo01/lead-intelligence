{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lead Intelligence",
  "version": "0.1.0",
  "identifier": "com.leadintelligence.desktop",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @lead/desktop dev",
    "beforeBuildCommand": "pnpm --filter @lead/desktop build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lead Intelligence",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
